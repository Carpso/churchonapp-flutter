# ════════════════════════════════════════════════════
# CHURCH ON APP - ENVIRONMENT VARIABLES
# ════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to version control.
# ════════════════════════════════════════════════════

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Maps
# Base (z0-15) basemap archive — always matches; the app over-zooms it past z15
# until a city archive below takes over. Build new ones with
# scripts/map/build-city-tiles.ps1 (or .sh).
MAPS_ZAMBIA_URL=https://maps.churchonapp.com/region-zm-zw-mw-mz.pmtiles
# Optional second country archive. Equals MAPS_ZAMBIA_URL by default (the
# regional build already covers Zimbabwe) — set a distinct URL only if you
# publish a standalone Zimbabwe archive.
MAPS_ZIMBABWE_URL=https://maps.churchonapp.com/region-zm-zw-mw-mz.pmtiles
# High-detail city archives the basemap switches to automatically. JSON array;
# bbox is [south, west, north, east]. A source is chosen when the camera is
# inside its bbox AND zoom is between minZoom and maxZoom (smallest bbox wins).
# Empty = base archive only.
MAPS_EXTRA_SOURCES=[{"name":"lusaka","bbox":[-15.78,27.66,-15.02,28.62],"minZoom":16,"maxZoom":19,"url":"https://maps.churchonapp.com/tiles/lusaka-z13-19.pmtiles"},{"name":"harare","bbox":[-18.12,30.7,-17.62,31.48],"minZoom":16,"maxZoom":19,"url":"https://maps.churchonapp.com/tiles/harare-z13-19.pmtiles"}]

# Live Streaming
LIVE_STREAM_URL=http://your-stream-url/live/

# Cloudflare R2
R2_ENDPOINT=https://your-r2-endpoint.r2.cloudflarestorage.com
R2_PUBLIC_DOMAIN=media.yourdomain.com

# Google
GEMINI_API_KEY=your-gemini-api-key
GOOGLE_WEB_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Lipila (Mobile Money) - Server-side only
LIPILA_SHORT_CODE=00000
LIPILA_API_KEY=lsk_your-key-here
LIPILA_WEBHOOK_URL=https://your-domain.com/functions/v1/lipila-webhook
LIPILA_PAYOUT_WEBHOOK_URL=https://your-domain.com/functions/v1/lipila-webhook

# AI
HUGGINGFACE_TOKEN=hf_your-token-here

# Firebase Cloud Messaging (Edge Function env vars)
FCM_PROJECT_ID=your-firebase-project-id
FCM_SERVICE_ACCOUNT={"type":"service_account",...}
FCM_SERVER_KEY=your-fcm-server-key

# Apple (Edge Function env vars)
APPLE_TEAM_ID=your-apple-team-id

# Treasury user UUID (platform revenue account in profiles table)
TREASURY_ID=00000000-0000-0000-0000-000000000000

# COA Money — single number for all platform collections (Lipila)
# Used by: buy_coins, checkout, missions donations, coa_payment_sheet
# Changeable at runtime by superadmin via Superadmin Hub
COA_MOMO_NUMBER=0976847775
COA_MOMO_NAME=Church On App Official
COA_TREASURY_PHONE=2609776847775

# Maps: turn-by-turn routing endpoint (OSRM-compatible). Defaults to the public
# OSRM demo server (rate-limited, no SLA) - point at your own OSRM/Valhalla
# instance before ride/delivery volume grows.
OSRM_BASE_URL=https://router.project-osrm.org/route/v1/driving

# Maps: optional self-hosted / paid forward-geocoding endpoint (Nominatim-shaped
# /search JSON). When set it is tried BEFORE public Nominatim; Photon is the
# final fallback. Leave blank to use the public chain.
GEOCODING_BASE_URL=

# Maps: optional live-traffic RASTER tile template. This is a COMPILE-TIME
# --dart-define (NOT a .env entry), e.g.:
#   flutter build apk --dart-define=TRAFFIC_TILES_URL=https://<host>/{z}/{x}/{y}.png
# Leave unset to use the crowd-sourced driver-speed traffic overlay (no key).
TRAFFIC_TILES_URL=
