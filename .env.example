# Church On App – Environment Variables (Example)
# Copy this to .env and fill in your values.
#
# Architecture:
#   churchonapp.com → Cloudflare Pages (Flutter web frontend)
#   supabase.churchonapp.com → Cloudflare Worker → Supabase (API proxy)
#   media.churchonapp.com → Cloudflare R2 (choa-sermons-vault)
#   maps.churchonapp.com → Cloudflare R2 (church-on-app-maps)
#   live.churchonapp.com → streaming server

SUPABASE_URL=https://supabase.churchonapp.com
SUPABASE_ANON_KEY=your-anon-key-here

MAPS_ZAMBIA_URL=https://maps.churchonapp.com/zambia.pmtiles
MAPS_ZIMBABWE_URL=https://maps.churchonapp.com/zimbabwe.pmtiles
LIVE_STREAM_URL=https://live.churchonapp.com/live/

R2_ENDPOINT=https://your-r2-endpoint.r2.cloudflarestorage.com
R2_PUBLIC_DOMAIN=media.churchonapp.com
R2_BUCKET=choa-sermons-vault

GEMINI_API_KEY=your-gemini-api-key
LIPILA_SHORT_CODE=68907
LIPILA_API_KEY=your-lipila-api-key
LIPILA_WEBHOOK_URL=https://supabase.churchonapp.com/functions/v1/lipila-webhook
LIPILA_PAYOUT_WEBHOOK_URL=https://supabase.churchonapp.com/functions/v1/lipila-webhook
LIPILA_WEBHOOK_SECRET=your-lipila-webhook-secret
GOOGLE_WEB_CLIENT_ID=your-google-web-client-id
