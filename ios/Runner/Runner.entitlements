<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Required for FCM/APNs push. Without this the app can never register a
	     device token, so NO iOS push is delivered. Enable the "Push
	     Notifications" capability in Xcode and upload an APNs key in Firebase. -->
	<key>aps-environment</key>
	<string>production</string>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:churchonapp.com</string>
		<string>applinks:www.churchonapp.com</string>
	</array>
</dict>
</plist>
