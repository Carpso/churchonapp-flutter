<?xml version="1.0" encoding="utf-8"?>
<!--
  SECURITY: Disable cloud-backup and device-transfer of app data.
  The app caches the Supabase session token, wallet/coin balances and KYC
  payloads in SharedPreferences — these must never be extracted to another
  device or to cloud backup.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
