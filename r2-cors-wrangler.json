{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://churchonapp.com",
          "https://www.churchonapp.com",
          "http://localhost:3000",
          "http://localhost:8080"
        ],
        "methods": ["GET", "HEAD"],
        "headers": ["*"]
      },
      "exposeHeaders": ["ETag", "Content-Length", "Content-Type"],
      "maxAgeSeconds": 3600
    }
  ]
}
